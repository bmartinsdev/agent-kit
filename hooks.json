{
  "agent-kit-safety-guard": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "./scripts/session-start.py",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/pre-tool-guard.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
